# 复制为 .env 后生效。留空 DEEPSEEK_API_KEY 即使用免费规则引擎。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 采集频率（秒）
INTERVAL_JIN10=60
INTERVAL_OIL=60
INTERVAL_RSS=900
INTERVAL_CZCE=120
INTERVAL_FRED=21600
INTERVAL_WORKER=20
INTERVAL_DIGEST=3600

# 关闭调度器（仅调试接口时）
ENABLE_SCHEDULER=true
